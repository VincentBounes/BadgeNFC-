<?xml version="1.0" encoding="utf-8"?>
<!--
    AID : F0394148148100 — AID propriétaire (plage F0 = libre)
    Le lecteur envoie un SELECT AID, on répond, puis on gère les échanges.
    Pour les systèmes qui vérifient uniquement l'UID (la majorité des vieux systèmes),
    l'UID est transmis au niveau RF par le chip NFC Android, indépendamment de cette config.
-->
<host-apdu-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/hce_service_description"
    android:requireDeviceUnlock="false">
    <aid-group
        android:description="@string/hce_service_description"
        android:category="other">
        <aid-filter android:name="F0394148148100" />
    </aid-group>
</host-apdu-service>
